pico-8 cartridge // http://www.pico-8.com
version 42
__lua__
-- test_title.p8 : draws the title and game-over screens and dumps them as
-- the pictures "title" and "won". run it with: py run_tests.py
-- title_dragon.lua is generated from ../dragon.lua by run_tests.py, with
-- the fighting (which these screens never reach) stubbed out for room.
#include gen_data.lua
#include gen_core.lua
#include gen_world.lua
#include gen_units.lua
#include title_dragon.lua
#include gen_main.lua
#include dump.lua
function sfx() end
music=sfx
dset=sfx
_init()
assert(wards==3,"expected the three town churches to be the wards")
damage_building(goal,50)
assert(goal.hp==goal.max_hp,"the goal was harmed through its ward")
for n=1,60 do
 _update()
 _draw()
end
dump_screen("title")
end_game("won")
end_frame-=60 -- skip the two seconds the ending plays out for
_draw()
dump_screen("won")
printh("ok title")
extcmd("shutdown")
__gfx__
