pico-8 cartridge // http://www.pico-8.com
version 29
__lua__
-- prototype 00
-- by drachis

--player obj
player={}
player.x=64
player.y=64
player.dx=0
player.dy=0
player.w=1
player.h=1
player.f=2 --frame
player.d=1 --flip/direction
frame_offset=1
function _draw()
	cls(0) --clear screen to black
	camera(0,0) -- camera top left at 0,0
	map() --draw the map (128x32)
	spr(player.f,
	player.x,player.y,
	player.w,player.h,
	player.d==-1) --place a sprite and cycle it
end

function _update()
 ac = 0.45 --acceleration
  --keys, lrudox,⬅️➡️⬆️⬇️🅾️❎
 if (btn(⬅️)) 
 then
  player.dx-=ac
  player.d=-1
  frame_offset=1
 end
 
 if (btn(➡️)) 
 then
  player.dx+=ac
  player.d=1
  frame_offset=1
 end
 
 if (btn(⬆️))
 then
  player.dy-=ac
  frame_offset=3
 end
   
 if (btn(⬇️))
 then
  player.dy+=ac
  frame_offset=5
 end
 
 player.x+=player.dx
 player.y+=player.dy
 --t is time, 30fps
 local player_friction=1-.3
 player.dx*=player_friction
 player.dy*=player_friction
 
	
 playback_mult=2
 if (abs(player.dx)>0.02 or
  abs(player.dy)>0.02)
 then
  player.f=(
  (t()*playback_mult)%2
  )+frame_offset
 else
  player.f=frame_offset
 end
end

