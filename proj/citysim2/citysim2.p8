pico-8 cartridge // http://www.pico-8.com
version 42
__lua__
-- citysim2 : agent/market city sim, single 8k cart.
-- see DESIGN.md (contract + budget) and ../citysim/LEARNINGS.md.
-- modules are #included in dependency order; add each as it lands.
#include params.lua
#include data.lua
#include notify.lua
#include map.lua
#include router.lua
#include net.lua
#include landval.lua
#include terrain.lua
#include agents.lua
#include sim.lua
#include disaster.lua
#include fx.lua
#include tools.lua
#include render.lua
#include inspector.lua
#include econ.lua
#include hud.lua
#include minimap.lua
#include daynight.lua
#include save.lua

-- glue owns _init/_update/_draw; modules never define them.
function _init()
 init_map()
 gen_terrain()
 update_net()
 init_agents()
 init_sim()
 sim_seed()
 init_econ()
 init_fire()
 init_log()
 init_fx()
 init_tools()
 update_camera(true)
 mapview=false
 menuitem(1,"save city",save_city)
 menuitem(2,"load city",load_city)
 menuitem(3,"map view",function() mapview=not mapview end)
 menuitem(4,"start fire",start_fire)
end

function _update()
 update_tools()
 update_sim()
 update_agents()
 update_econ()
 update_fx()
 maybe_ignite()
end

function _draw()
 cls(0)
 draw_world()
 if mapview then draw_minimap() else draw_inspector() end
 draw_log()
 draw_hud()
 print(tools_list[tool],1,121,10)
end
