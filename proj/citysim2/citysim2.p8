pico-8 cartridge // http://www.pico-8.com
version 42
__lua__
-- citysim2 : agent/market city sim, single 8k cart.
-- see DESIGN.md (contract + budget) and ../citysim/LEARNINGS.md.
-- modules are #included in dependency order; add each as it lands.
#include params.lua
#include data.lua
#include map.lua
#include router.lua
#include net.lua
#include terrain.lua
#include agents.lua
#include sim.lua
#include tools.lua
#include render.lua
#include inspector.lua

-- glue owns _init/_update/_draw; modules never define them.
function _init()
 init_map()
 gen_terrain()
 update_net()
 init_agents()
 init_sim()
 sim_seed()
 init_tools()
 update_camera(true)
end

function _update()
 update_tools()
 update_sim()
 update_agents()
end

function _draw()
 cls(0)
 draw_world()
 print("pop "..pop.." jobs "..jobs,1,1,7)
 print(tools_list[tool],1,121,10)
 draw_inspector()
end
