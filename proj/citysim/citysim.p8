pico-8 cartridge // http://www.pico-8.com
version 42
__lua__
-- citysim : a tiny rci city builder
-- see design.md for the module contract

#include map.lua
#include power.lua
#include growth.lua
#include econ.lua
#include landval.lua
#include tools.lua
#include traffic.lua
#include disaster.lua
#include savegame.lua
#include ui.lua

function set_tax_item()
 menuitem(1,"tax rate: "..tax_rate,function()
  tax_rate=tax_rate%3+1
  set_tax_item()
 end)
end

function _init()
 frame=0
 init_map()
 init_tools()
 init_power()
 init_econ()
 init_growth()
 init_landval()
 init_traffic()
 init_disaster()
 update_power()
 set_tax_item()
 menuitem(2,"start fire",start_fire)
 menuitem(3,"save city",save_city)
 menuitem(4,"load city",load_city)
 menuitem(5,"new city",new_city)
end

function sim_tick()
 frame+=1
 update_growth()
 update_landval()
 update_traffic()
 update_disaster()
 update_econ()
 if frame%16==0 then update_power() end
 if power_short and frame%300==0 then
  msg,msg_t="low power - build plants",90
 end
end

function _update()
 update_tools()
 for i=1,gspd do sim_tick() end
end

function _draw()
 cls()
 draw_world()
 draw_hud()
 if mode=="menu" then draw_menu() end
 if mode=="map" then draw_minimap() end
 draw_msg()
end
